# Sao chép file này thành .env và điền giá trị THẬT (không commit .env lên Git!)
PORT=5000
NODE_ENV=development            # trên Render đặt: production

# --- Database (dùng DB RIÊNG cho dev/test, tên DB nên chứa "dev" hoặc "test") ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/menstyle_dev?retryWrites=true&w=majority

# --- Xác thực ---
JWT_SECRET=<chuoi-ngau-nhien-toi-thieu-64-ky-tu>
JWT_EXPIRE=7d

# --- Admin (chỉ dùng khi chạy seeder, tối thiểu 10 ký tự) ---
ADMIN_PASSWORD=<mat-khau-admin-manh>

# --- Thanh toán QR ---
BANK_ID=MB
BANK_ACCOUNT_NO=<so-tai-khoan>
BANK_ACCOUNT_NAME=<TEN CHU TAI KHOAN>
MOMO_PHONE=<so-dien-thoai-momo>

# --- AI Stylist (Gemini) ---
GEMINI_API_KEY=<gemini-api-key>

# --- Email hóa đơn (tùy chọn; Gmail dùng App Password) ---
EMAIL_USER=
EMAIL_PASS=

# --- Tùy chọn ---
# CORS_ORIGINS=https://ten-mien-rieng.vn,https://www.ten-mien-rieng.vn
# AUTO_SEED_ARTICLES=true       # chỉ bật khi muốn tự nạp 8 bài viết mẫu vào DB trống
